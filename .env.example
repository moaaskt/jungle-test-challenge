# ==============================================================================
# Jungle Gaming Test Challenge — Exemplo de Configuração de Ambiente (.env)
# ==============================================================================

# Porta TCP onde o servidor HTTP da aplicação escutará
PORT=8080

# URL de conexão com o banco de dados PostgreSQL (com migrations executadas)
# Para execução no host do desenvolvedor:
DATABASE_URL=postgres://jungle:password@localhost:5432/jungle_test?sslmode=disable
# Para execução dentro da rede do Docker Compose:
# DATABASE_URL=postgres://jungle:password@db:5432/jungle_test?sslmode=disable

# Endpoint e Região AWS / LocalStack para mensageria SQS
# Para execução no host do desenvolvedor:
AWS_ENDPOINT=http://localhost:4566
# Para execução dentro da rede do Docker Compose:
# AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1

# Nomes das filas FIFO do SQS
SQS_WAGER_REQUESTS_QUEUE=wager-transactions.fifo
SQS_WAGER_EVENTS_QUEUE=wager-events.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo

# Configurações do IdP Keycloak (OAuth2 / OpenID Connect)
# Para execução no host do desenvolvedor:
KEYCLOAK_URL=http://localhost:8085
# Para execução dentro da rede do Docker Compose:
# KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=jungle

# Habilitar autenticação e autorização via JWT / JWKS (true/false)
AUTH_ENABLED=true
